rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() { return request.auth != null; }
    function underSize(mb) { return request.resource.size < mb * 1024 * 1024; }
    function isImage() { return request.resource.contentType.matches('image/.*'); }

    // Default: deny everything not explicitly allowed below.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // User avatars / attachments — owner writes their own folder, public read. Images <=5MB.
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId && underSize(5) && isImage();
    }

    // Event files (covers, partner logos, uploads). Organizer/staff scoping is enforced
    // in-app — Storage rules cannot read Firestore — so gate on auth + a size cap. Public read.
    match /events/{eventId}/{fileName=**} {
      allow read: if true;
      allow write: if signedIn() && underSize(20);
    }

    // Bulk ID cards — generated by the generateBulkIdCards Cloud Function (admin SDK
    // bypasses these rules); clients only read. Public read (links are un-guessable).
    match /idCards/{eventId}/{fileName=**} {
      allow read: if true;
      allow write: if false;
    }

    // Certificates — written only by the generateCertificate Cloud Function. Signed-in read
    // (filenames are application IDs, un-guessable).
    match /certificates/{eventId}/{fileName=**} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
